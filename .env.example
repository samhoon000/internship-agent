# Backend Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
ADMIN_API_KEY=super-secret-admin-key

# Database Connection (PostgreSQL)
# You can define either a unified connection string DATABASE_URL OR individual DB variables.
# DATABASE_URL is preferred for Supabase/Neon/Render deployments.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/internship
# DB_SSL=true # Uncomment for production Supabase/Neon deployments

# Alternate individual variables (fallback if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=internship

# Redis Connection (BullMQ & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Python Scraper Configuration (also used by Docker worker)
PLAYWRIGHT_HEADLESS=True
